---
layout: null
---
{% comment %}
  Search index. Includes static pages (site.pages) AND every collection document
  (site.documents). Fields: title, tags, description, section, content — so titles,
  descriptions, tags, and (via full content) headings + code-block text are all
  searchable. Ranking boosts are applied client-side in _includes/scripts.html.
{% endcomment %}
[
  {% assign items = site.pages | concat: site.documents | where_exp: "p", "p.title != nil" %}
  {% for page in items %}
  {
    "title": {{ page.title | jsonify }},
    "url": "{{ page.url | relative_url }}",
    "section": {{ page.section | default: "" | replace: "-", " " | jsonify }},
    "tags": {{ page.tags | default: empty | join: " " | jsonify }},
    "description": {{ page.description | default: "" | jsonify }},
    "content": {{ page.content | strip_html | truncatewords: 200 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
